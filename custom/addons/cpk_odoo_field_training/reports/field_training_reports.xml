<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- ========================================= -->
        <!-- QWeb 報表定義 (QWeb Reports)              -->
        <!-- ========================================= -->

        <!-- 測試報表動作定義 -->
        <record id="action_report_field_training_test" model="ir.actions.report">
            <field name="name">欄位類型訓練報表 (測試版)</field>
            <field name="model">cpk.field.training</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">cpk_odoo_field_training.report_field_training_document_simple</field>
            <field name="report_file">cpk_odoo_field_training.report_field_training_document_simple</field>
            <field name="binding_model_id" ref="model_cpk_field_training"/>
            <field name="binding_type">report</field>
        </record>

        <!-- 報表動作定義 -->
        <record id="action_report_field_training" model="ir.actions.report">
            <field name="name">欄位類型訓練報表</field>
            <field name="model">cpk.field.training</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">cpk_odoo_field_training.report_field_training_document</field>
            <field name="report_file">cpk_odoo_field_training.report_field_training_document</field>
            <field name="binding_model_id" ref="model_cpk_field_training"/>
            <field name="binding_type">report</field>
        </record>

        <!-- HTML 版本報表動作 -->
        <record id="action_report_field_training_html" model="ir.actions.report">
            <field name="name">欄位類型訓練報表 (HTML)</field>
            <field name="model">cpk.field.training</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">cpk_odoo_field_training.report_field_training_document</field>
            <field name="report_file">cpk_odoo_field_training.report_field_training_document</field>
            <field name="binding_model_id" ref="model_cpk_field_training"/>
            <field name="binding_type">report</field>
        </record>

        <!-- 明細報表動作 -->
        <record id="action_report_field_training_detailed" model="ir.actions.report">
            <field name="name">欄位類型訓練詳細報表</field>
            <field name="model">cpk.field.training</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">cpk_odoo_field_training.report_field_training_detailed</field>
            <field name="report_file">cpk_odoo_field_training.report_field_training_detailed</field>
            <field name="binding_model_id" ref="model_cpk_field_training"/>
            <field name="binding_type">report</field>
        </record>

        <!-- ========================================= -->
        <!-- QWeb 報表模板 (QWeb Report Templates)     -->
        <!-- ========================================= -->

        <!-- 測試用簡化報表模板 -->
        <template id="report_field_training_document_simple">
            <t t-call="web.basic_layout">
                <t t-call-assets="web.report_assets_common" t-js="false"/>
                <style>
                    @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;700&amp;display=swap');
                    
                    body, * {
                        font-family: 'Noto Sans TC', 'Microsoft JhengHei', 'PingFang TC', 'Hiragino Sans GB', 'Microsoft YaHei', SimHei, sans-serif !important;
                        -webkit-font-smoothing: antialiased;
                        -moz-osx-font-smoothing: grayscale;
                    }
                    
                    .chinese-content {
                        font-family: 'Noto Sans TC', 'Microsoft JhengHei', 'PingFang TC', 'Hiragino Sans GB', 'Microsoft YaHei', SimHei, sans-serif !important;
                        font-weight: 400;
                    }
                    
                    .chinese-title {
                        font-family: 'Noto Sans TC', 'Microsoft JhengHei', 'PingFang TC', 'Hiragino Sans GB', 'Microsoft YaHei', SimHei, sans-serif !important;
                        font-weight: 700;
                    }
                </style>
                
                <div class="article o_report_layout_standard">
                    <div class="page" style="padding: 20px;">
                        <h1 class="chinese-title">欄位類型訓練報表 - 測試版</h1>
                        <p class="chinese-content">記錄總數：<span t-esc="len(docs) if docs else 0"/></p>
                        
                        <t t-if="not docs">
                            <div style="color: red; border: 2px solid red; padding: 10px; margin: 10px 0;">
                                <h3 class="chinese-title">DEBUG: 沒有收到任何記錄資料</h3>
                                <p class="chinese-content">可能原因：</p>
                                <ul class="chinese-content">
                                    <li>篩選條件沒有匹配到任何記錄</li>
                                    <li>資料沒有正確傳遞到報表模板</li>
                                    <li>模型查詢失敗</li>
                                </ul>
                            </div>
                        </t>
                        
                        <t t-if="docs">
                            <div style="color: green; border: 2px solid green; padding: 10px; margin: 10px 0;">
                                <h3 class="chinese-title">SUCCESS: 找到 <span t-esc="len(docs)"/> 筆記錄</h3>
                            </div>
                            
                            <t t-foreach="docs" t-as="doc">
                                <div style="border: 1px solid #ccc; margin: 10px 0; padding: 15px; background-color: #f9f9f9;">
                                    <h3 class="chinese-title">記錄 #<span t-esc="doc_index + 1"/></h3>
                                    <table style="width: 100%; border-collapse: collapse;">
                                        <tr>
                                            <td class="chinese-content" style="border: 1px solid #ddd; padding: 8px; font-weight: bold;">姓名：</td>
                                            <td class="chinese-content" style="border: 1px solid #ddd; padding: 8px;"><span t-field="doc.name"/></td>
                                        </tr>
                                        <tr>
                                            <td class="chinese-content" style="border: 1px solid #ddd; padding: 8px; font-weight: bold;">代碼：</td>
                                            <td class="chinese-content" style="border: 1px solid #ddd; padding: 8px;"><span t-field="doc.code"/></td>
                                        </tr>
                                        <tr>
                                            <td class="chinese-content" style="border: 1px solid #ddd; padding: 8px; font-weight: bold;">狀態：</td>
                                            <td class="chinese-content" style="border: 1px solid #ddd; padding: 8px;"><span t-field="doc.status"/></td>
                                        </tr>
                                        <tr>
                                            <td class="chinese-content" style="border: 1px solid #ddd; padding: 8px; font-weight: bold;">開始日期：</td>
                                            <td class="chinese-content" style="border: 1px solid #ddd; padding: 8px;"><span t-field="doc.start_date"/></td>
                                        </tr>
                                        <tr>
                                            <td class="chinese-content" style="border: 1px solid #ddd; padding: 8px; font-weight: bold;">記錄 ID：</td>
                                            <td class="chinese-content" style="border: 1px solid #ddd; padding: 8px;"><span t-esc="doc.id"/></td>
                                        </tr>
                                    </table>
                                    
                                    <!-- 照片測試區塊 -->
                                    <div style="margin-top: 15px; padding: 10px; background-color: #f8f9fa; border: 1px solid #dee2e6;">
                                        <h4 class="chinese-title">照片欄位測試</h4>
                                        <div style="display: flex; gap: 20px;">
                                            <div style="flex: 1; text-align: center;">
                                                <p class="chinese-content"><strong>主要照片 (Image)：</strong></p>
                                                <t t-if="doc.image">
                                                    <img t-att-src="'data:image/png;base64,%s' % doc.image.decode('ascii')" 
                                                         style="max-width: 120px; max-height: 120px; border: 2px solid #007bff; border-radius: 8px;"
                                                         alt="主要照片"/>
                                                    <p class="chinese-content" style="color: green; font-size: 12px;">✓ 照片顯示成功</p>
                                                </t>
                                                <t t-else="">
                                                    <div style="width: 120px; height: 120px; border: 2px dashed #6c757d; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                                                        <span class="chinese-content" style="color: #6c757d; font-size: 12px;">無照片</span>
                                                    </div>
                                                    <p class="chinese-content" style="color: orange; font-size: 12px;">! 尚未上傳照片</p>
                                                </t>
                                            </div>
                                            <div style="flex: 1; text-align: center;">
                                                <p class="chinese-content"><strong>頭像 (Avatar)：</strong></p>
                                                <t t-if="doc.avatar">
                                                    <img t-att-src="'data:image/png;base64,%s' % doc.avatar.decode('ascii')" 
                                                         style="max-width: 80px; max-height: 80px; border: 2px solid #28a745; border-radius: 50%;"
                                                         alt="頭像"/>
                                                    <p class="chinese-content" style="color: green; font-size: 12px;">✓ 頭像顯示成功</p>
                                                </t>
                                                <t t-else="">
                                                    <div style="width: 80px; height: 80px; border: 2px dashed #6c757d; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                                                        <span class="chinese-content" style="color: #6c757d; font-size: 10px;">無頭像</span>
                                                    </div>
                                                    <p class="chinese-content" style="color: orange; font-size: 12px;">! 尚未設定頭像</p>
                                                </t>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </t>
                        
                        <div class="chinese-content" style="margin-top: 30px; padding: 10px; background-color: #e8f4f8;">
                            <p><strong>測試說明：</strong>此為除錯用的簡化報表模板，用於診斷報表資料傳遞問題。</p>
                            <p><strong>時間：</strong><span t-esc="datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/></p>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- 主要報表模板 -->
        <template id="report_field_training_document">
            <t t-call="web.html_container">
                <t t-call-assets="web.report_assets_common" t-js="false"/>
                <style>
                    body, * {
                        font-family: 'Microsoft JhengHei', 'PingFang TC', 'Hiragino Sans GB', 'Microsoft YaHei', SimHei, 'DejaVu Sans', sans-serif !important;
                    }
                </style>
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.external_layout">
                        <div class="page" style="font-family: 'Microsoft JhengHei', 'PingFang TC', 'Hiragino Sans GB', 'Microsoft YaHei', SimHei, 'DejaVu Sans', sans-serif;">
                            <!-- 報表標題 -->
                            <div class="oe_structure"/>
                            
                            <div class="row">
                                <div class="col-12">
                                    <h2 class="text-center mb-4">
                                        <strong>Odoo 欄位類型訓練報表</strong>
                                    </h2>
                                </div>
                            </div>

                            <!-- 基本資訊區塊 -->
                            <div class="row mb-4">
                                <!-- 照片區塊 -->
                                <div class="col-3">
                                    <h5>照片資訊</h5>
                                    <div class="text-center">
                                        <t t-if="doc.image">
                                            <img t-att-src="'data:image/png;base64,%s' % doc.image.decode('ascii')" 
                                                 style="max-width: 150px; max-height: 150px; border: 2px solid #dee2e6; border-radius: 8px;"
                                                 alt="主要照片"/>
                                            <p class="mt-2"><small>主要照片</small></p>
                                        </t>
                                        <t t-else="">
                                            <div style="width: 150px; height: 150px; border: 2px dashed #dee2e6; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                                                <span style="color: #6c757d;">無照片</span>
                                            </div>
                                            <p class="mt-2"><small>主要照片</small></p>
                                        </t>
                                        
                                        <!-- 頭像區塊 -->
                                        <div class="mt-3">
                                            <t t-if="doc.avatar">
                                                <img t-att-src="'data:image/png;base64,%s' % doc.avatar.decode('ascii')" 
                                                     style="max-width: 80px; max-height: 80px; border: 1px solid #dee2e6; border-radius: 50%;"
                                                     alt="頭像"/>
                                                <p class="mt-1"><small>頭像</small></p>
                                            </t>
                                            <t t-else="">
                                                <div style="width: 80px; height: 80px; border: 1px dashed #dee2e6; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                                                    <span style="color: #6c757d; font-size: 12px;">無頭像</span>
                                                </div>
                                                <p class="mt-1"><small>頭像</small></p>
                                            </t>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- 基本資訊左欄 -->
                                <div class="col-4">
                                    <table class="table table-sm table-borderless">
                                        <tr>
                                            <td><strong>姓名：</strong></td>
                                            <td><span t-field="doc.name"/></td>
                                        </tr>
                                        <tr>
                                            <td><strong>代碼：</strong></td>
                                            <td><span t-field="doc.code"/></td>
                                        </tr>
                                        <tr>
                                            <td><strong>狀態：</strong></td>
                                            <td>
                                                <span t-field="doc.status" 
                                                      t-options="{'widget': 'badge'}"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td><strong>優先度：</strong></td>
                                            <td><span t-field="doc.priority"/></td>
                                        </tr>
                                        <tr>
                                            <td><strong>年齡：</strong></td>
                                            <td><span t-field="doc.age"/></td>
                                        </tr>
                                    </table>
                                </div>
                                
                                <!-- 基本資訊右欄 -->
                                <div class="col-5">
                                    <table class="table table-sm table-borderless">
                                        <tr>
                                            <td><strong>負責人：</strong></td>
                                            <td><span t-field="doc.user_id"/></td>
                                        </tr>
                                        <tr>
                                            <td><strong>聯絡人：</strong></td>
                                            <td><span t-field="doc.partner_id"/></td>
                                        </tr>
                                        <tr>
                                            <td><strong>開始日期：</strong></td>
                                            <td><span t-field="doc.start_date"/></td>
                                        </tr>
                                        <tr>
                                            <td><strong>建立日期：</strong></td>
                                            <td><span t-field="doc.create_date" 
                                                      t-options="{'widget': 'datetime'}"/></td>
                                        </tr>
                                        <tr>
                                            <td><strong>生日：</strong></td>
                                            <td><span t-field="doc.birth_date"/></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>

                            <!-- 數值資訊區塊 -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h4>數值資訊</h4>
                                    <table class="table table-sm">
                                        <thead class="table-light">
                                            <tr>
                                                <th>項目</th>
                                                <th class="text-right">數量</th>
                                                <th class="text-right">單價</th>
                                                <th class="text-right">總金額</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>基本數值</td>
                                                <td class="text-right">
                                                    <span t-field="doc.quantity"/>
                                                </td>
                                                <td class="text-right">
                                                    <span t-field="doc.price" 
                                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                                </td>
                                                <td class="text-right">
                                                    <span t-field="doc.amount_total" 
                                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- 明細資訊區塊 -->
                            <t t-if="doc.line_ids">
                                <div class="row mb-4">
                                    <div class="col-12">
                                        <h4>明細資訊</h4>
                                        <table class="table table-sm table-bordered">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>序號</th>
                                                    <th>項目名稱</th>
                                                    <th>說明</th>
                                                    <th class="text-right">數量</th>
                                                    <th class="text-right">單價</th>
                                                    <th class="text-right">小計</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <t t-foreach="doc.line_ids" t-as="line">
                                                    <tr>
                                                        <td><span t-field="line.sequence"/></td>
                                                        <td><span t-field="line.name"/></td>
                                                        <td><span t-field="line.description"/></td>
                                                        <td class="text-right"><span t-field="line.quantity"/></td>
                                                        <td class="text-right">
                                                            <span t-field="line.price" 
                                                                  t-options="{'widget': 'float', 'precision': 2}"/>
                                                        </td>
                                                        <td class="text-right">
                                                            <span t-field="line.subtotal" 
                                                                  t-options="{'widget': 'float', 'precision': 2}"/>
                                                        </td>
                                                    </tr>
                                                </t>
                                            </tbody>
                                            <tfoot>
                                                <tr class="table-active">
                                                    <td colspan="5" class="text-right"><strong>總計：</strong></td>
                                                    <td class="text-right">
                                                        <strong>
                                                            <span t-esc="sum(doc.line_ids.mapped('subtotal'))" 
                                                                  t-options="{'widget': 'float', 'precision': 2}"/>
                                                        </strong>
                                                    </td>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                </div>
                            </t>

                            <!-- 布林值和選項資訊 -->
                            <div class="row mb-4">
                                <div class="col-6">
                                    <h5>布林值資訊</h5>
                                    <ul class="list-unstyled">
                                        <li>
                                            <i t-attf-class="fa #{doc.is_active and 'fa-check text-success' or 'fa-times text-danger'}"/>
                                            啟用狀態
                                        </li>
                                        <li>
                                            <i t-attf-class="fa #{doc.is_completed and 'fa-check text-success' or 'fa-times text-danger'}"/>
                                            完成狀態
                                        </li>
                                    </ul>
                                </div>
                                <div class="col-6">
                                    <h5>其他資訊</h5>
                                    <ul class="list-unstyled">
                                        <li><strong>年齡：</strong> <span t-field="doc.age"/></li>
                                        <li><strong>性別：</strong> <span t-field="doc.gender"/></li>
                                        <li><strong>明細行數：</strong> <span t-field="doc.total_lines"/></li>
                                    </ul>
                                </div>
                            </div>

                            <!-- 說明內容 -->
                            <t t-if="doc.description">
                                <div class="row mb-4">
                                    <div class="col-12">
                                        <h5>說明內容</h5>
                                        <div class="border p-3" style="min-height: 100px;">
                                            <span t-field="doc.description"/>
                                        </div>
                                    </div>
                                </div>
                            </t>

                            <!-- 頁腳資訊 -->
                            <div class="oe_structure"/>
                            <div class="row">
                                <div class="col-12 text-center text-muted">
                                    <hr/>
                                    <p>
                                        報表產生時間：<span t-esc="datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
                                    </p>
                                    <p>
                                        <small>此報表由 Odoo 欄位類型教育訓練模組自動產生</small>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </t>
        </template>

        <!-- 詳細報表模板 -->
        <template id="report_field_training_detailed">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="web.external_layout">
                        <div class="page">
                            <div class="oe_structure"/>
                            
                            <div class="row">
                                <div class="col-12">
                                    <h2 class="text-center mb-4">
                                        <strong>Odoo 欄位類型訓練詳細報表</strong>
                                    </h2>
                                </div>
                            </div>

                            <!-- 照片展示區塊 -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h4>圖片欄位類型展示</h4>
                                    <div class="row">
                                        <div class="col-6">
                                            <div class="text-center" style="border: 1px solid #dee2e6; padding: 20px; border-radius: 8px;">
                                                <h6>Image 欄位 (主要照片)</h6>
                                                <t t-if="doc.image">
                                                    <img t-att-src="'data:image/png;base64,%s' % doc.image.decode('ascii')" 
                                                         style="max-width: 200px; max-height: 200px; border: 2px solid #007bff; border-radius: 8px;"
                                                         alt="主要照片"/>
                                                    <p class="mt-2 text-success"><small><strong>✓ 已上傳照片</strong></small></p>
                                                </t>
                                                <t t-else="">
                                                    <div style="width: 200px; height: 200px; border: 2px dashed #6c757d; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                                                        <span style="color: #6c757d;">尚未上傳照片</span>
                                                    </div>
                                                    <p class="mt-2 text-muted"><small>無照片資料</small></p>
                                                </t>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="text-center" style="border: 1px solid #dee2e6; padding: 20px; border-radius: 8px;">
                                                <h6>Image 欄位 (頭像 - 限制尺寸)</h6>
                                                <t t-if="doc.avatar">
                                                    <img t-att-src="'data:image/png;base64,%s' % doc.avatar.decode('ascii')" 
                                                         style="max-width: 128px; max-height: 128px; border: 2px solid #28a745; border-radius: 50%;"
                                                         alt="頭像"/>
                                                    <p class="mt-2 text-success"><small><strong>✓ 已設定頭像</strong></small></p>
                                                    <p class="text-muted"><small>限制尺寸: 128x128 像素</small></p>
                                                </t>
                                                <t t-else="">
                                                    <div style="width: 128px; height: 128px; border: 2px dashed #6c757d; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                                                        <span style="color: #6c757d; font-size: 12px;">無頭像</span>
                                                    </div>
                                                    <p class="mt-2 text-muted"><small>尚未設定頭像</small></p>
                                                    <p class="text-muted"><small>限制尺寸: 128x128 像素</small></p>
                                                </t>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- 完整的欄位資訊展示 -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h4>基本欄位類型展示</h4>
                                    <table class="table table-sm table-bordered">
                                        <tbody>
                                            <tr>
                                                <td><strong>Char 欄位 (姓名)</strong></td>
                                                <td><span t-field="doc.name"/></td>
                                                <td><strong>Char 欄位 (代碼)</strong></td>
                                                <td><span t-field="doc.code"/></td>
                                            </tr>
                                            <tr>
                                                <td><strong>Integer 欄位 (數量)</strong></td>
                                                <td><span t-field="doc.quantity"/></td>
                                                <td><strong>Integer 欄位 (年齡)</strong></td>
                                                <td><span t-field="doc.age"/></td>
                                            </tr>
                                            <tr>
                                                <td><strong>Float 欄位 (價格)</strong></td>
                                                <td><span t-field="doc.price"/></td>
                                                <td><strong>Float 欄位 (重量)</strong></td>
                                                <td><span t-field="doc.weight"/></td>
                                            </tr>
                                            <tr>
                                                <td><strong>Boolean 欄位 (啟用)</strong></td>
                                                <td>
                                                    <span t-if="doc.is_active" class="text-success">✓ 是</span>
                                                    <span t-else="" class="text-danger">✗ 否</span>
                                                </td>
                                                <td><strong>Boolean 欄位 (完成)</strong></td>
                                                <td>
                                                    <span t-if="doc.is_completed" class="text-success">✓ 是</span>
                                                    <span t-else="" class="text-danger">✗ 否</span>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td><strong>Date 欄位 (生日)</strong></td>
                                                <td><span t-field="doc.birth_date"/></td>
                                                <td><strong>Date 欄位 (開始日期)</strong></td>
                                                <td><span t-field="doc.start_date"/></td>
                                            </tr>
                                            <tr>
                                                <td><strong>Datetime 欄位 (訂單時間)</strong></td>
                                                <td><span t-field="doc.order_datetime"/></td>
                                                <td><strong>Datetime 欄位 (最後更新)</strong></td>
                                                <td><span t-field="doc.last_update"/></td>
                                            </tr>
                                            <tr>
                                                <td><strong>Selection 欄位 (狀態)</strong></td>
                                                <td><span t-field="doc.status"/></td>
                                                <td><strong>Selection 欄位 (優先度)</strong></td>
                                                <td><span t-field="doc.priority"/></td>
                                            </tr>
                                            <tr>
                                                <td><strong>Selection 欄位 (性別)</strong></td>
                                                <td><span t-field="doc.gender"/></td>
                                                <td><strong>Monetary 欄位 (總金額)</strong></td>
                                                <td>
                                                    <span t-field="doc.amount_total" 
                                                          t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- 關係欄位展示 -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <h4>關係欄位類型展示</h4>
                                    <table class="table table-sm table-bordered">
                                        <tbody>
                                            <tr>
                                                <td><strong>Many2one 欄位 (聯絡人)</strong></td>
                                                <td><span t-field="doc.partner_id"/></td>
                                            </tr>
                                            <tr>
                                                <td><strong>Many2one 欄位 (負責人)</strong></td>
                                                <td><span t-field="doc.user_id"/></td>
                                            </tr>
                                            <tr>
                                                <td><strong>Many2one 欄位 (公司)</strong></td>
                                                <td><span t-field="doc.company_id"/></td>
                                            </tr>
                                            <tr>
                                                <td><strong>Related 欄位 (客戶信箱)</strong></td>
                                                <td><span t-field="doc.partner_email"/></td>
                                            </tr>
                                            <tr>
                                                <td><strong>Related 欄位 (客戶電話)</strong></td>
                                                <td><span t-field="doc.partner_phone"/></td>
                                            </tr>
                                            <tr>
                                                <td><strong>Many2many 欄位 (標籤)</strong></td>
                                                <td>
                                                    <t t-foreach="doc.tag_ids" t-as="tag">
                                                        <span class="badge badge-secondary mr-1" t-esc="tag.name"/>
                                                    </t>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td><strong>Computed 欄位 (計算總行數)</strong></td>
                                                <td><span t-field="doc.total_lines"/></td>
                                            </tr>
                                            <tr>
                                                <td><strong>Computed 欄位 (全名)</strong></td>
                                                <td><span t-field="doc.full_name"/></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Text 和 HTML 欄位展示 -->
                            <t t-if="doc.description or doc.html_content">
                                <div class="row mb-4">
                                    <div class="col-12">
                                        <h4>文字內容欄位</h4>
                                        
                                        <t t-if="doc.description">
                                            <h6>Text 欄位 (描述)</h6>
                                            <div class="border p-3 mb-3">
                                                <span t-field="doc.description"/>
                                            </div>
                                        </t>
                                        
                                        <t t-if="doc.html_content">
                                            <h6>HTML 欄位 (HTML 內容)</h6>
                                            <div class="border p-3">
                                                <span t-field="doc.html_content"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>

                            <div class="oe_structure"/>
                        </div>
                    </t>
                </t>
            </t>
        </template>

    </data>
</odoo>
        <field name="code">01</field>
        <field name="name">交通費(公出)</field>
        <field name="is_leaf" eval="False"/>
    </record>

    <record id="expense_category_02" model="cpk.expense.category">
        <field name="code">02</field>
        <field name="name">差旅費</field>
        <field name="is_leaf" eval="False"/>

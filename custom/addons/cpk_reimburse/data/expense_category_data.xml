    <!-- 稅別初始資料 -->
    <record id="tax_code_vn" model="cpk.tax.code">
        <field name="code">VN</field>
        <field name="name">與稅無關</field>
    </record>

    <record id="tax_code_vb" model="cpk.tax.code">
        <field name="code">VB</field>
        <field name="name">進項三聯式收銀機統一發票、載有稅額憑證－進貨及費用應稅5%(稅額500元以下免辦登錄)</field>
    </record>

    <record id="tax_code_va" model="cpk.tax.code">
        <field name="code">VA</field>
        <field name="name">進項二聯式發票、電子計算機發票－進貨及費用應稅5%(稅額500元以下免辦登錄)</field>
    </record>

    <record id="tax_code_v1" model="cpk.tax.code">
        <field name="code">V1</field>
        <field name="name">進項稅5%海關代徵營業稅繳納證－進貨及費用</field>
    </record>

    <record id="tax_code_v3" model="cpk.tax.code">
        <field name="code">V3</field>
        <field name="name">進項稅5%載有稅額之其他憑證(二聯式收銀機統一發票)－進貨及費用</field>
    </record>

    <record id="tax_code_v2" model="cpk.tax.code">
        <field name="code">V2</field>
        <field name="name">進項稅5%三聯式收銀機(電子發票)－進貨及費用</field>

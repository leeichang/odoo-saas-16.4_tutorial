<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 費用類別 Tree View -->
    <record id="view_cpk_expense_category_tree" model="ir.ui.view">
        <field name="name">cpk.expense.category.tree</field>
        <field name="model">cpk.expense.category</field>
        <field name="arch" type="xml">
            <tree string="費用類別">
                <field name="code"/>
                <field name="name"/>
                <field name="complete_name"/>
                <field name="account_id"/>
                <field name="is_leaf"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- 費用類別 Form View -->
    <record id="view_cpk_expense_category_form" model="ir.ui.view">
        <field name="name">cpk.expense.category.form</field>
        <field name="model">cpk.expense.category</field>
        <field name="arch" type="xml">
            <form string="費用類別">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="complete_name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="parent_id"/>
                        </group>
                        <group>
                            <field name="account_id"/>
                            <field name="is_leaf" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="子分類" name="child_categories" attrs="{'invisible': [('is_leaf', '=', True)]}">
                            <field name="child_ids">
                                <tree string="子分類">
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="account_id"/>
                                    <field name="is_leaf"/>
                                    <field name="active"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 費用類別 Search View -->
    <record id="view_cpk_expense_category_search" model="ir.ui.view">
        <field name="name">cpk.expense.category.search</field>
        <field name="model">cpk.expense.category</field>
        <field name="arch" type="xml">
            <search string="費用類別搜尋">
                <field name="code"/>
                <field name="name"/>
                <field name="complete_name"/>
                <field name="account_id"/>
                <separator/>
                <filter name="filter_leaf" string="明細類別" domain="[('is_leaf', '=', True)]"/>
                <filter name="filter_parent" string="父類別" domain="[('is_leaf', '=', False)]"/>
                <separator/>
                <filter name="filter_active" string="有效" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="無效" domain="[('active', '=', False)]"/>
                <group expand="0" string="分組">
                    <filter string="父類別" name="group_parent" context="{'group_by': 'parent_id'}"/>
                    <filter string="是否為明細" name="group_leaf" context="{'group_by': 'is_leaf'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cpk_expense_category" model="ir.actions.act_window">
        <field name="name">費用類別</field>
        <field name="res_model">cpk.expense.category</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立費用類別設定！
            </p>
        </field>
    </record>

</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 稅別 Tree View -->
    <record id="view_cpk_tax_code_tree" model="ir.ui.view">
        <field name="name">cpk.tax.code.tree</field>
        <field name="model">cpk.tax.code</field>
        <field name="arch" type="xml">
            <tree string="稅別" editable="top">
                <field name="code"/>
                <field name="name"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- 稅別 Form View -->
    <record id="view_cpk_tax_code_form" model="ir.ui.view">
        <field name="name">cpk.tax.code.form</field>
        <field name="model">cpk.tax.code</field>
        <field name="arch" type="xml">
            <form string="稅別">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options='{"terminology": "archive"}'/>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    
                    <group>
                        <field name="code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 稅別 Search View -->
    <record id="view_cpk_tax_code_search" model="ir.ui.view">
        <field name="name">cpk.tax.code.search</field>
        <field name="model">cpk.tax.code</field>
        <field name="arch" type="xml">
            <search string="稅別搜尋">
                <field name="code"/>
                <field name="name"/>
                <separator/>
                <filter name="filter_active" string="有效" domain="[('active', '=', True)]"/>
                <filter name="filter_inactive" string="無效" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cpk_tax_code" model="ir.actions.act_window">
        <field name="name">稅別設定</field>
        <field name="res_model">cpk.tax.code</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立稅別設定！
            </p>
        </field>
    </record>

</odoo>
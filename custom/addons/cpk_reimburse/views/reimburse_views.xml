<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 請款單 Tree View (unchanged) -->
    <record id="view_cpk_reimburse_tree" model="ir.ui.view">
        <field name="name">cpk.reimburse.tree</field>
        <field name="model">cpk.reimburse</field>
        <field name="arch" type="xml">
            <tree string="費用請款單" decoration-info="state=='draft'" decoration-muted="state=='closed'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="partner_id"/>
                <field name="payment_method_id"/>
                <field name="due_date"/>
                <field name="currency_id"/>
                <field name="total_amount" sum="總金額"/>
                <field name="total_tax" sum="總稅額"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <!-- 請款單 Form View -->
    <record id="view_cpk_reimburse_form" model="ir.ui.view">
        <field name="name">cpk.reimburse.form</field>
        <field name="model">cpk.reimburse</field>
        <field name="arch" type="xml">
            <form string="費用請款單">
                <header>
                    <button name="%(action_cpk_reimburse_print_wizard)d" string="列印" type="action" class="btn-primary"/>
                    <button name="%(action_excel_import_wizard)d" string="Excel匯入" type="action" class="btn-secondary" attrs="{'invisible': [('state', 'not in', ['draft'])]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,submitted,approved,paid,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="reimburse_date"/>
                            <field name="partner_id"/>
                            <field name="alternative_payee"/>
                            <field name="bank_id"/>
                            <field name="account_holder"/>
                            <field name="bank_account"/>
                        </group>
                        <group>
                            <field name="payment_method_id"/>
                            <field name="payment_base_date"/>
                            <field name="due_date"/>
                            <field name="currency_id"/>
                            <field name="exchange_rate"/>
                            <field name="advance_balance"/>
                            <field name="is_printed"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="基本資料" name="basic_info">
                            <div class="oe_left">
                                <button name="action_create_voucher" string="新增憑證" type="object" class="btn-primary"/>
                            </div>
                            <field name="expense_line_ids" 
                                   context="{'default_reimburse_id': id}" 
                                   options="{'no_create': True}">
                                <tree string="請款明細" create="false" open ="false">
                                    <field name="sequence" widget="handle"/>
                                    <field name="invoice_number" string="發票"/>
                                    <field name="expense_category_id"/>
                                    <field name="cost_center_id"/>
                                    <field name="amount_total"/>
                                    <field name="amount_untaxed"/>
                                    <field name="tax_amount"/>
                                    <field name="analytic_account_id"/>
                                    <field name="description"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="voucher_id" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="憑證明細" name="voucher_info">
                            <field name="voucher_ids" context="{'default_reimburse_id': id}">
                                <tree string="憑證資料">
                                    <field name="voucher_type"/>
                                    <field name="invoice_date"/>
                                    <field name="tax_code_id"/>
                                    <field name="tax_id"/>
                                    <field name="invoice_number"/>
                                    <field name="amount_total"/>
                                    <field name="amount_untaxed"/>
                                    <field name="tax_amount"/>
                                    <field name="is_consolidated"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                    <group>
                        <group>
                            <field name="notes" colspan="2"/>
                        </group>
                        <group>
                            <field name="total_amount" widget="monetary"/>
                            <field name="total_tax" widget="monetary"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 憑證資料 Form View (updated for preview) -->
    <record id="view_cpk_voucher_form" model="ir.ui.view">
        <field name="name">cpk.voucher.form</field>
        <field name="model">cpk.voucher</field>
        <field name="arch" type="xml">
            <form string="憑證資料">
                <sheet>
                    <group>
                        <field name="reimburse_id" invisible="1"/>
                        <group>
                            <field name="voucher_type"/>
                            <field name="invoice_date"/>
                            <field name="tax_code_id"/>
                            <field name="tax_id"/>
                            <field name="invoice_number"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                            <field name="amount_untaxed"/>
                            <field name="tax_amount"/>
                            <field name="is_consolidated"/>
                        </group>
                    </group>
                    
                    <group string="上傳憑證">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                    </group>

                    <notebook>
                        <page string="請款明細">
                            <field name="expense_line_ids" context="{'default_reimburse_id': reimburse_id}">
                                <tree string="請款明細" editable="bottom">
                                    <field name="reimburse_id" invisible="1"/>
                                    <field name="voucher_id" invisible="1"/>
                                    <field name="sequence" widget="handle"/>
                                    <field name="expense_category_id"/>
                                    <field name="cost_center_id"/>
                                    <field name="amount_total"/>
                                    <field name="amount_untaxed"/>
                                    <field name="tax_amount"/>
                                    <field name="analytic_account_id"/>
                                    <field name="description"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                                <form string="請款明細">
                                    <group>
                                        <field name="reimburse_id" invisible="1"/>
                                        <field name="voucher_id" invisible="1"/>
                                        <field name="sequence"/>
                                        <field name="expense_category_id"/>
                                        <field name="cost_center_id"/>
                                        <field name="analytic_account_id"/>
                                        <field name="amount_total"/>
                                        <field name="amount_untaxed"/>
                                        <field name="tax_amount"/>
                                        <field name="currency_id" invisible="1"/>
                                    </group>
                                    <group>
                                        <field name="description" colspan="2"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 請款明細完整 Dialog Form -->
    <record id="view_cpk_expense_line_dialog" model="ir.ui.view">
        <field name="name">cpk.expense.line.dialog</field>
        <field name="model">cpk.expense.line</field>
        <field name="arch" type="xml">
            <form string="費用報銷明細">
                <sheet>
                    <!-- 憑證資料區塊 -->
                    <group string="憑證資料">
                        <field name="reimburse_id" invisible="1"/>
                        <field name="voucher_id" context="{'default_reimburse_id': reimburse_id}" options="{'no_create': False}"/>
                    </group>

                    <!-- 費用明細區塊 -->
                    <group string="費用明細">
                        <group>
                            <field name="sequence"/>
                            <field name="expense_category_id"/>
                            <field name="cost_center_id"/>
                            <field name="analytic_account_id"/>
                        </group>
                        <group>
                            <field name="amount_total"/>
                            <field name="amount_untaxed"/>
                            <field name="tax_amount"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    
                    <group>
                        <field name="description" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions (unchanged) -->
    <record id="action_cpk_reimburse" model="ir.actions.act_window">
        <field name="name">費用請款單</field>
        <field name="res_model">cpk.reimburse</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立您的第一筆費用請款單！
            </p>
        </field>
    </record>

    <record id="action_cpk_voucher" model="ir.actions.act_window">
        <field name="name">憑證資料</field>
        <field name="res_model">cpk.voucher</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
    </record>

</odoo>
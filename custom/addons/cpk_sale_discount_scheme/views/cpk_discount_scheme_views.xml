<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 折扣方案類型 Tree View -->
    <record id="view_cpk_discount_scheme_type_tree" model="ir.ui.view">
        <field name="name">cpk.discount.scheme.type.tree</field>
        <field name="model">cpk.discount.scheme.type</field>
        <field name="arch" type="xml">
            <tree string="折扣方案類型">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="description"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- 折扣方案類型 Form View -->
    <record id="view_cpk_discount_scheme_type_form" model="ir.ui.view">
        <field name="name">cpk.discount.scheme.type.form</field>
        <field name="model">cpk.discount.scheme.type</field>
        <field name="arch" type="xml">
            <form string="折扣方案類型">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_cpk_discount_scheme)d" 
                                type="action" 
                                class="oe_stat_button" 
                                icon="fa-tags"
                                context="{'search_default_scheme_type_id': active_id}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">方案</span>
                            </div>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="已停用" bg_color="bg-danger" 
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    
                    <group string="技術設定">
                        <field name="engine_class"/>
                    </group>
                    
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 折扣方案主檔 Tree View -->
    <record id="view_cpk_discount_scheme_tree" model="ir.ui.view">
        <field name="name">cpk.discount.scheme.tree</field>
        <field name="model">cpk.discount.scheme</field>
        <field name="arch" type="xml">
            <tree string="折扣方案" decoration-info="state=='active'" decoration-muted="state=='inactive'">
                <field name="name"/>
                <field name="code"/>
                <field name="scheme_type_id"/>
                <field name="priority"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="rule_count"/>
                <field name="state" widget="badge"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- 折扣方案主檔 Form View -->
    <record id="view_cpk_discount_scheme_form" model="ir.ui.view">
        <field name="name">cpk.discount.scheme.form</field>
        <field name="model">cpk.discount.scheme</field>
        <field name="arch" type="xml">
            <form string="折扣方案">
                <header>
                    <button name="action_activate" string="啟用" type="object" 
                            class="btn-primary" attrs="{'invisible': [('state', '=', 'active')]}"/>
                    <button name="action_deactivate" string="停用" type="object" 
                            class="btn-secondary" attrs="{'invisible': [('state', '!=', 'active')]}"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,inactive"/>
                </header>
                
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_rules" type="object" 
                                class="oe_stat_button" icon="fa-list-ul">
                            <field name="rule_count" widget="statinfo" string="規則"/>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="已停用" bg_color="bg-danger" 
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="方案名稱..."/>
                        </h1>
                    </div>
                    
                    <group>
                        <group name="basic_info">
                            <field name="code"/>
                            <field name="scheme_type_id"/>
                            <field name="priority"/>
                        </group>
                        <group name="date_range">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- 基本設定 -->
                        <page string="基本設定">
                            <group string="適用範圍">
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="pricelist_ids" widget="many2many_tags"/>
                                <field name="partner_ids" widget="many2many_tags"/>
                            </group>
                            
                            <group string="說明">
                                <field name="description" nolabel="1"/>
                            </group>
                        </page>
                        
                        <!-- 搭售規則 -->
                        <page string="搭售規則">
                            <field name="bundle_rule_ids" context="{'default_scheme_id': active_id}">
                                <tree>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="main_product_id"/>
                                    <field name="bundle_product_count"/>
                                    <field name="tier_count"/>
                                    <field name="active"/>
                                </tree>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="name"/>
                                                <field name="main_product_id"/>
                                                <field name="bundle_selection_type"/>
                                            </group>
                                            <group>
                                                <field name="sequence"/>
                                                <field name="active"/>
                                            </group>
                                        </group>
                                        
                                        <group string="搭售條件" 
                                               attrs="{'invisible': [('bundle_selection_type', '=', 'all_required')]}">
                                            <field name="min_bundle_qty" 
                                                   attrs="{'invisible': [('bundle_selection_type', '!=', 'min_quantity')]}"/>
                                            <field name="min_bundle_amount" 
                                                   attrs="{'invisible': [('bundle_selection_type', '!=', 'min_amount')]}"/>
                                            <field name="min_bundle_products" 
                                                   attrs="{'invisible': [('bundle_selection_type', '!=', 'min_products')]}"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        
                        <!-- 備註 -->
                        <page string="備註">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                
                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- 折扣方案主檔 Search View -->
    <record id="view_cpk_discount_scheme_search" model="ir.ui.view">
        <field name="name">cpk.discount.scheme.search</field>
        <field name="model">cpk.discount.scheme</field>
        <field name="arch" type="xml">
            <search string="折扣方案搜尋">
                <field name="name"/>
                <field name="code"/>
                <field name="scheme_type_id"/>
                
                <filter name="active_schemes" string="啟用方案" 
                        domain="[('state', '=', 'active')]"/>
                <filter name="inactive_schemes" string="停用方案" 
                        domain="[('state', '=', 'inactive')]"/>
                <filter name="current_schemes" string="目前有效" 
                        domain="['|', ('date_start', '=', False), ('date_start', '&lt;=', context_today()),
                                '|', ('date_end', '=', False), ('date_end', '&gt;=', context_today())]"/>
                
                <separator/>
                
                <group expand="0" string="分組">
                    <filter name="group_by_type" string="方案類型" 
                            context="{'group_by': 'scheme_type_id'}"/>
                    <filter name="group_by_state" string="狀態" 
                            context="{'group_by': 'state'}"/>
                    <filter name="group_by_priority" string="優先順序" 
                            context="{'group_by': 'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 動作定義 -->
    <record id="action_cpk_discount_scheme_type" model="ir.actions.act_window">
        <field name="name">折扣方案類型</field>
        <field name="res_model">cpk.discount.scheme.type</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立您的第一個折扣方案類型！
            </p>
            <p>
                折扣方案類型用於分類和管理不同種類的折扣規則。
            </p>
        </field>
    </record>

    <record id="action_cpk_discount_scheme" model="ir.actions.act_window">
        <field name="name">折扣方案</field>
        <field name="res_model">cpk.discount.scheme</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_current_schemes': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立您的第一個折扣方案！
            </p>
            <p>
                折扣方案讓您可以設定複雜的搭售折扣規則，提升銷售效益。
            </p>
        </field>
    </record>
</odoo>
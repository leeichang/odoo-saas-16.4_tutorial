<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 擴展價格檔 Form View -->
    <record id="view_product_pricelist_form_inherit" model="ir.ui.view">
        <field name="name">product.pricelist.form.cpk.discount.scheme</field>
        <field name="model">product.pricelist</field>
        <field name="inherit_id" ref="product.product_pricelist_view"/>
        <field name="arch" type="xml">
            <!-- 在按鈕區域加入折扣方案按鈕 -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_discount_schemes" type="object" 
                        class="oe_stat_button" icon="fa-tags">
                    <field name="scheme_count" widget="statinfo" string="折扣方案"/>
                </button>
            </xpath>
            
            <!-- 在 notebook 中加入折扣方案頁籤 -->
            <xpath expr="//notebook" position="inside">
                <page string="關聯的折扣方案" name="discount_schemes">
                    <field name="discount_scheme_ids">
                        <tree>
                            <field name="name"/>
                            <field name="scheme_type_id"/>
                            <field name="priority"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="state" widget="badge"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 搭售折扣規則 Tree View -->
    <record id="view_cpk_bundle_discount_rule_tree" model="ir.ui.view">
        <field name="name">cpk.bundle.discount.rule.tree</field>
        <field name="model">cpk.bundle.discount.rule</field>
        <field name="arch" type="xml">
            <tree string="搭售折扣規則" decoration-muted="not active">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="scheme_id"/>
                <field name="main_product_id"/>
                <field name="bundle_selection_type"/>
                <field name="bundle_product_count"/>
                <field name="tier_count"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- 搭售折扣規則 Form View -->
    <record id="view_cpk_bundle_discount_rule_form" model="ir.ui.view">
        <field name="name">cpk.bundle.discount.rule.form</field>
        <field name="model">cpk.bundle.discount.rule</field>
        <field name="arch" type="xml">
            <form string="搭售折扣規則">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bundle_products" type="object" 
                                class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="bundle_product_count" widget="statinfo" string="搭售商品"/>
                        </button>
                        <button name="action_view_tiers" type="object" 
                                class="oe_stat_button" icon="fa-bar-chart">
                            <field name="tier_count" widget="statinfo" string="級距"/>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="已停用" bg_color="bg-danger" 
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="規則名稱..."/>
                        </h1>
                    </div>
                    
                    <group>
                        <group name="basic_info">
                            <field name="scheme_id"/>
                            <field name="main_product_id" 
                                   options="{'no_create': True, 'no_create_edit': True}"/>
                            <field name="main_product_category_id"/>
                        </group>
                        <group name="settings">
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="currency_id"/>
                        </group>
                    </group>

                    <notebook>
                        <!-- 搭售條件 -->
                        <page string="搭售條件">
                            <group string="搭售類型">
                                <field name="bundle_selection_type" widget="radio"/>
                            </group>
                            
                            <group string="條件設定" 
                                   attrs="{'invisible': [('bundle_selection_type', '=', 'all_required')]}">
                                <group>
                                    <field name="min_bundle_qty" 
                                           attrs="{'invisible': [('bundle_selection_type', '!=', 'min_quantity')],
                                                  'required': [('bundle_selection_type', '=', 'min_quantity')]}"/>
                                    <field name="min_bundle_amount" 
                                           attrs="{'invisible': [('bundle_selection_type', '!=', 'min_amount')],
                                                  'required': [('bundle_selection_type', '=', 'min_amount')]}"/>
                                </group>
                                <group>
                                    <field name="min_bundle_products" 
                                           attrs="{'invisible': [('bundle_selection_type', '!=', 'min_products')],
                                                  'required': [('bundle_selection_type', '=', 'min_products')]}"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- 搭售商品 -->
                        <page string="搭售商品">
                            <field name="bundle_product_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" 
                                           options="{'no_create': True, 'no_create_edit': True}"/>
                                    <field name="product_category_id"/>
                                    <field name="product_group"/>
                                    <field name="is_required"/>
                                    <field name="min_qty"/>
                                    <field name="max_qty"/>
                                    <field name="list_price"/>
                                    <field name="description"/>
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="product_id" 
                                                   options="{'no_create': True, 'no_create_edit': True}"/>
                                            <field name="product_category_id"/>
                                            <field name="product_uom_id"/>
                                        </group>
                                        <group>
                                            <field name="product_group"/>
                                            <field name="group_min_select"/>
                                            <field name="sequence"/>
                                        </group>
                                    </group>
                                    
                                    <group string="搭售條件">
                                        <group>
                                            <field name="is_required"/>
                                            <field name="min_qty"/>
                                        </group>
                                        <group>
                                            <field name="max_qty"/>
                                            <field name="list_price"/>
                                        </group>
                                    </group>
                                    
                                    <group string="說明">
                                        <field name="description" nolabel="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        
                        <!-- 數量級距 -->
                        <page string="數量級距">
                            <field name="tier_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="min_main_qty"/>
                                    <field name="max_main_qty"/>
                                    <field name="qty_range_display"/>
                                    <field name="main_discount_type"/>
                                    <field name="main_discount_value"/>
                                    <field name="main_discount_display"/>
                                    <field name="bundle_discount_type"/>
                                    <field name="bundle_discount_value"/>
                                    <field name="bundle_discount_display"/>
                                </tree>
                                <form>
                                    <group>
                                        <group>
                                            <field name="name"/>
                                            <field name="sequence"/>
                                        </group>
                                        <group>
                                            <field name="currency_id"/>
                                        </group>
                                    </group>
                                    
                                    <group string="數量範圍">
                                        <group>
                                            <field name="min_main_qty"/>
                                            <field name="max_main_qty"/>
                                        </group>
                                        <group>
                                            <field name="qty_range_display"/>
                                        </group>
                                    </group>
                                    
                                    <group string="主商品折扣">
                                        <group>
                                            <field name="main_discount_type"/>
                                            <field name="main_discount_value"/>
                                        </group>
                                        <group>
                                            <field name="main_discount_display"/>
                                        </group>
                                    </group>
                                    
                                    <group string="搭售商品折扣">
                                        <group>
                                            <field name="bundle_discount_type"/>
                                            <field name="bundle_discount_value"/>
                                        </group>
                                        <group>
                                            <field name="bundle_discount_display"/>
                                        </group>
                                    </group>
                                    
                                    <group string="說明">
                                        <field name="description" nolabel="1"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        
                        <!-- 說明 -->
                        <page string="說明">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                
                <!-- Chatter -->
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- 搭售折扣規則 Search View -->
    <record id="view_cpk_bundle_discount_rule_search" model="ir.ui.view">
        <field name="name">cpk.bundle.discount.rule.search</field>
        <field name="model">cpk.bundle.discount.rule</field>
        <field name="arch" type="xml">
            <search string="搭售折扣規則搜尋">
                <field name="name"/>
                <field name="scheme_id"/>
                <field name="main_product_id"/>
                
                <filter name="active_rules" string="啟用規則" 
                        domain="[('active', '=', True)]"/>
                <filter name="inactive_rules" string="停用規則" 
                        domain="[('active', '=', False)]"/>
                
                <separator/>
                
                <group expand="0" string="分組">
                    <filter name="group_by_scheme" string="折扣方案" 
                            context="{'group_by': 'scheme_id'}"/>
                    <filter name="group_by_main_product" string="主商品" 
                            context="{'group_by': 'main_product_id'}"/>
                    <filter name="group_by_selection_type" string="搭售類型" 
                            context="{'group_by': 'bundle_selection_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 動作定義 -->
    <record id="action_cpk_bundle_discount_rule" model="ir.actions.act_window">
        <field name="name">搭售折扣規則</field>
        <field name="res_model">cpk.bundle.discount.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_active_rules': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                建立您的第一個搭售折扣規則！
            </p>
            <p>
                搭售折扣規則可以設定主商品與搭售商品的組合折扣邏輯。
            </p>
        </field>
    </record>
</odoo>